{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "globals": ["chrome"]
  },
  "files": {
    "includes": [
      "**",
      "!**/.github",
      "!**/_metadata",
      "!**/.pi",
      "!**/.pi-subagents",
      "!.bifrost-patterns.json",
      "!test-results",
      "!playwright-report",
      "!blob-report",
      "!**/dist"
    ]
  }
}
